# A second untouched copy of the game data (a reference for comparing)
Vanilla Tomb Raider (V) Chronicles Steam Version ENG/

# Old EXE states the user set aside, together with a SCRIPT.DAT copy -
# build artifacts and game data, none of it belongs in the repository.
Tomb5 Steam Version/Alte exen/

# A transcript dump, not project content
full_conversation.txt

# VS user/local files
*.vcxproj.user
.vs/

# Randomizer test levels - generated artifacts (~62 MB), regenerated any time
# via -exportinfo + -patchlevel, and derived from copyrighted game data.
# The hand-written exclusion list in that folder IS tracked (see below).
Preparation/Level Test/*.trc
Preparation/Level Test/**/*.trc

# Third-party GPL3 tool, kept locally as reference only (b122251's TRMOD)
Preparation/Tomb Raider Level Modifier By b122251/

# THE ORIGINAL LEVEL DATA. It must never enter the repository - that would
# be distributing game data. The folder itself must stay on the disk, it is
# the only untouched copy the tool knows about; only git keeps out of it.
# A "git add -A" took it along once; the commit was taken back before it
# went anywhere. That is why the rule stands here now and not only in the
# intention.
data Backup/

# The finished shipping package - generated, not written. Among other things
# it contains a complete copy of the TOMB5 source tree including licenses;
# that belongs in its place in the tree, not a second time here.
Release Package/

# Dear ImGui as a third-party library in its original release state. It is
# not modified, its history lives with its own project.
Preparation/imgui-*/

# Our own trview build (chreden/trview 2.9.1, GPL) plus a source copy - the
# history lives with the upstream project, the EXE is a build artifact.
# Build recipe see the task #105 context: 8.3 short path (spaces!),
# DirectXTK shaders once by hand with fxc, PreBuildEvent quotes.
Preparation/TRView for Tomb5 Rando/

# --- Foreign game data: NEVER commit it ---------------------------------------
#
# This project is under GPLv3 and ships no game data. Whoever wants the
# dinosaurs must own Tomb Raider 3; the randomizer fetches them at runtime
# from THEIR installation (#92). Everything lying around here while
# developing belongs to somebody else and must not enter the repository.
#
# See also the "Import-Export" folder next to the program - for the same
# reason it carries a file "DO NOT REDISTRIBUTE.txt".
Spiel/
New Checksums/
Import Export/
Outfit Test/
*.TR2
*.tr2
*.trc
*.SFX
*.sfx
*.bin
Compy Sounds/

# Generated WallTest levels (#61): derived game data, for trview only
Preparation/WallTest/

# Generated secret test levels (#53): derived game data
Preparation/SecretTest/

# Game data and third-party downloads - never version these
TOMB 5 (I).zip
Tomb Raider 5 (I).iso
Tomb Raider 5 Italy/
Preparation/stb-master/
Tomb5 Steam Version/savegame/

# The user's game installation - never belongs in the repo (setup.bat stays
# as an already tracked file of our own; the ignore only catches new files)
Tomb5 Steam Version/

# Backup bundles of the history - they contain old states, never upload
*.bundle

# Curation screenshots (game imagery) - valuable locally, never in the repo
Preparation/Level Infos/ZoneReports/**/*.jpg
Preparation/Level Infos/ZoneReports/**/*.png

# Fresh upstream downloads for comparisons - never version these
Tomb5 frisch*/

# Artwork drafts. The one logo that ships lives in docs/banner.jpg;
# these are the working files behind it and have no business in a
# repository people clone.
Logos/
