# VS user/local files
*.vcxproj.user
.vs/

# Randomizer test levels - generated artifacts (~62 MB), regenerated any time
# via -exportinfo + -patchlevel, and derived from copyrighted game data.
# The hand-written exclusion list in that folder IS tracked (see below).
Tomb5 Rando vorbereitung/Level Test/*.trc
Tomb5 Rando vorbereitung/Level Test/**/*.trc

# Third-party GPL3 tool, kept locally as reference only (b122251's TRMOD)
Tomb5 Rando vorbereitung/Tomb Raider Level Modifier By b122251/

# DIE ORIGINAL-LEVELDATEN. Sie duerfen niemals ins Repository - das waere
# Weitergabe von Spieldaten. Der Ordner selbst muss auf der Platte bleiben, er
# ist die einzige unberuehrte Kopie, die das Werkzeug kennt; nur git haelt sich
# hier heraus. Ein "git add -A" hat sie einmal mitgenommen, der Commit wurde
# zurueckgenommen, bevor er irgendwo hinging. Deshalb steht die Regel jetzt hier
# und nicht nur in der Absicht.
data Backup/

# Fertiges Auslieferungspaket - erzeugt, nicht geschrieben. Enthaelt unter
# anderem eine vollstaendige Kopie des TOMB5-Quellbaums samt Lizenzen; die
# gehoert an ihren Platz im Baum, nicht ein zweites Mal hierher.
Release Paket/

# Dear ImGui als Fremdbibliothek im Original-Release-Stand. Wird nicht
# geaendert, ihre Historie liegt bei ihrem eigenen Projekt.
Tomb5 Rando vorbereitung/imgui-*/

# Eigener trview-Bau (chreden/trview 2.9.1, GPL) samt Quellkopie - die
# Historie liegt beim Upstream-Projekt, die EXE ist ein Bauartefakt.
# Baurezept siehe Aufgabe #105-Umfeld: 8.3-Kurzpfad (Leerzeichen!),
# DirectXTK-Shader einmal von Hand mit fxc, PreBuildEvent-Quotes.
Tomb5 Rando vorbereitung/TRView f*r Tomb5 Rando/

# --- Fremde Spieldaten: NIEMALS mitcommitten ---------------------------------
#
# Dieses Projekt steht unter GPLv3 und liefert keine Spieldaten mit. Wer die
# Dinosaurier will, muss Tomb Raider 3 besitzen; der Randomizer holt sie zur
# Laufzeit aus SEINER Installation (#92). Alles, was hier beim Entwickeln
# herumliegt, gehoert jemand anderem und darf nicht ins Repository.
#
# Siehe auch den Ordner "Import-Export" neben dem Programm - er traegt aus
# demselben Grund eine Datei "NICHT MITLIEFERN.txt".
Spiel/
Neue chechsums/
Import Export/
Outfit Test/
*.TR2
*.tr2
*.trc
*.SFX
*.sfx
*.bin
Compy Sounds/

