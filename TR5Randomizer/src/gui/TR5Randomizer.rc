// The randomizer's program icon. The logo is the project's own (drawn
// outside the repository, Logos\ - not tracked);
// TR5Randomizer.ico carries it in six sizes (16 to 256) as PNG entries -
// Windows picks the fitting one depending on the display.
//
// 101 is the first icon number: for the window and the taskbar Windows
// takes the icon with the SMALLEST number from the EXE unless code sets
// something else. Main.cpp additionally sets it explicitly.
#define IDI_APPICON 101
IDI_APPICON ICON "TR5Randomizer.ico"

// The interface's background image - the same project banner, from
// Logos\Tomb5 Rando Logo 1920x1080.png. Embedded as JPEG and not as PNG:
// this image is photo-like, PNG needs 3.1 MB for it, JPEG at quality 88
// only 0.5 MB. The difference is not visible because the image lies
// heavily darkened behind the interface.
//
// Embedded instead of sitting next to it as a file, so the EXE stays
// runnable on its own and nobody deletes the image by accident.
#define IDR_BACKGROUND 201
IDR_BACKGROUND RCDATA "Background.jpg"

// VS_VERSION_INFO is the constant 1 and comes from winres.h. Without the
// include, rc stores the block under the NAME "VS_VERSION_INFO" instead
// of resource id 1, the strings land in the EXE, and Windows still
// reports 0.0.0.0 - which is exactly what happened the first time.
#include <winres.h>

// The application manifest, shared with the command-line programs: what the
// EXE declares to Windows (rights, supported versions, long paths).
// src\Program.manifest says why each line is there.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "..\\Program.manifest"

// What Windows shows in the file properties. Without this the EXE has no
// version at all, and a bug report cannot say which build it came from.
// FILEVERSION takes numbers only, so the readable name lives in the
// strings; keep both in step with RANDO_VERSION_STRING in BuildId.h, and
// with src\Tools.rc, which carries the same block for the CLI programs.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,0,0,0
 PRODUCTVERSION 4,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ChrisChanSan"
            VALUE "FileDescription", "Randomizer for Tomb Raider Chronicles"
            VALUE "FileVersion", "Beta_4.0"
            VALUE "InternalName", "TR5Randomizer.exe"
            VALUE "LegalCopyright", "GPLv3. Copyright 2026 ChrisChanSan."
            VALUE "OriginalFilename", "TR5Randomizer.exe"
            VALUE "ProductName", "TR5 Randomizer"
            VALUE "ProductVersion", "Beta_4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
